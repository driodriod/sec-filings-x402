# Wallet that receives the USDC payments for paid 8-K packets.
# On mainnet this receives REAL money: use an address you control.
PAY_TO_ADDRESS=0xYourWalletAddress

# The SEC requires a User-Agent with your app name and a contact email
SEC_USER_AGENT="sec-filings-x402 you@example.com"

# "base-sepolia" (default): test money, public x402.org facilitator, no account needed.
# "base": REAL USDC on Base mainnet via Coinbase's CDP facilitator, which also
#         lists the endpoint in the x402 Bazaar. Needs the two CDP keys below.
NETWORK=base-sepolia

# Coinbase Developer Platform API key (https://portal.cdp.coinbase.com).
# Only needed when NETWORK=base. Keep these secret.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Price per filing in US dollars (paid in USDC), between 0.000001 and 100.
PRICE_USD=0.02

PORT=4022
POLL_INTERVAL_MS=10000

# Test buyer for `npm run buy` (testnet only; created automatically on first run)
# BUYER_PRIVATE_KEY=

# --- news-server.js (optional Finnhub watcher) ---
# FINNHUB_API_KEY=
